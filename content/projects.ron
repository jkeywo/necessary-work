// The prototype project catalogue: ~12 projects, weighted toward power.
// Every project acts only through the controlled effect vocabulary, with
// explicit scopes. Values are illustrative, rounded, and balance-driven.
//
// Context blocks follow the in-game citation structure (what / why / depends
// on / limits / in this scenario / abstraction / sources). Sources are named
// informally here; full evidence records arrive with the vertical slice.
(
    projects: [
        // ------------------------------------------------------ enabling
        (
            id: "grid-modernisation",
            title: "Grid Modernisation",
            summary: "Rebuild and extend the electricity grid so large shares of renewable generation can connect and balance.",
            finance_cost: 600,
            mandate_cost: 0,
            duration_ticks: 200,
            repeat: CappedRollout(per_continent: 1),
            cost_curve: Flat,
            activation: Completion,
            effects: [
                (op: AddIcon(icon: Infrastructure, amount: 2), scope: LeadContinent),
                (op: AddIcon(icon: Institutions, amount: 1), scope: LeadContinent),
            ],
            context: (
                what: "Transmission build-out, interconnection standards, and grid operations able to absorb variable renewables.",
                why: "Grid capability is a binding constraint on how fast wind and solar can be deployed and used.",
                depends_on: "Planning capacity, permitting, and long-lead equipment supply chains.",
                limits: "Grids enable other reductions but cut little on their own.",
                in_this_scenario: "An enabling investment: it adds Infrastructure and Institutions capacity that scales later deployment.",
                abstraction: "One programme per continent stands in for decades of network investment.",
                sources: ["IPCC AR6 WGIII ch.6", "IEA Net Zero Roadmap (2023 update)"],
            ),
        ),
        // --------------------------------------------------------- power
        (
            id: "wind-solar-deployment",
            title: "Wind & Solar Deployment",
            summary: "Roll out utility wind and solar generation, displacing fossil electricity.",
            finance_cost: 500,
            mandate_cost: 0,
            duration_ticks: 150,
            repeat: Repeatable,
            cost_curve: ScaleThenDeplete(discount_permille: 40, floor_count: 5, growth_permille: 70),
            activation: Completion,
            scaling: [
                (icon: Infrastructure, permille_per_icon: 80, cap_permille: 600),
            ],
            breakpoints: [
                (id: "skilled-installation-crews", icon: Workforce, at_least: 4, bonus_permille: 150),
            ],
            effects: [
                (op: ReduceSectorEmissions(sector: Power, milli_gt: 600), scope: LeadContinent),
                (op: AddIcon(icon: Workforce, amount: 1), scope: LeadContinent),
            ],
            context: (
                what: "Successive tranches of utility-scale wind and solar with the balancing they need.",
                why: "Electricity decarbonisation enables, but does not complete, every other transition.",
                depends_on: "Grid capacity, installation workforce, and manufacturing scale.",
                limits: "Early tranches get cheaper with scale; late tranches face integration costs and weaker sites.",
                in_this_scenario: "The workhorse direct reduction for Power, scaling with installed Infrastructure.",
                abstraction: "Wind and solar are merged into one deployment track; storage and demand response are folded in.",
                sources: ["IEA Net Zero Roadmap (2023 update)", "IPCC AR6 WGIII ch.6"],
            ),
        ),
        (
            id: "clean-manufacturing-scaleup",
            title: "Clean Manufacturing Scale-up",
            summary: "Build the factories and supply chains that make clean-energy hardware cheap.",
            finance_cost: 700,
            mandate_cost: 0,
            duration_ticks: 180,
            repeat: CappedRollout(per_continent: 1),
            cost_curve: Flat,
            activation: Completion,
            effects: [
                (op: AddIcon(icon: Knowledge, amount: 2), scope: LeadContinent),
                (op: ModifyProjectCost(project: "wind-solar-deployment", permille: -100), scope: Global),
                (op: AddFinanceIncome(milli_per_tick: 1500), scope: Global),
            ],
            context: (
                what: "Manufacturing capacity, learning-by-doing, and standards for turbines, modules, and power electronics.",
                why: "Deployment cost falls with cumulative manufacturing experience, not with time.",
                depends_on: "Industrial policy, skilled labour, and materials supply.",
                limits: "Cost declines are logistic, not unlimited; concentration creates supply-chain risk.",
                in_this_scenario: "An enabling investment: cheaper wind and solar everywhere, plus export income.",
                abstraction: "Learning-curve effects are compressed into one discrete cost modifier.",
                sources: ["IPCC AR6 WGIII ch.2", "IEA Net Zero Roadmap (2023 update)"],
            ),
        ),
        (
            id: "nuclear-fleet",
            title: "Nuclear Fleet Programme",
            summary: "A standardised fleet build of nuclear plants for firm low-carbon power.",
            finance_cost: 1500,
            mandate_cost: 5,
            duration_ticks: 400,
            repeat: Tiered(count: 3),
            cost_curve: Linear(increment_permille: 150),
            activation: Completion,
            effects: [
                (op: ReduceSectorEmissions(sector: Power, milli_gt: 1500), scope: LeadContinent),
                (op: AddIcon(icon: Knowledge, amount: 1), scope: LeadContinent),
                (op: AddIcon(icon: Workforce, amount: 1), scope: LeadContinent),
                (op: AddMaintenance(milli_per_tick: 500), scope: Global),
            ],
            context: (
                what: "A fleet-scale programme of standardised reactors, in the mould of the 1970s-80s French build.",
                why: "Firm low-carbon capacity complements variable renewables in deep power decarbonisation.",
                depends_on: "Strong institutions, a stable order book, and a trained construction and operations workforce.",
                limits: "Long lead times, high capital cost, and ongoing operations spending; contested politics.",
                in_this_scenario: "A large, slow, mandate-hungry Power reduction with permanent upkeep.",
                abstraction: "Siting, licensing, and waste handling are folded into the Mandate cost and duration.",
                sources: ["IPCC AR6 WGIII ch.6", "IEA Net Zero Roadmap (2023 update)"],
            ),
        ),
        (
            id: "coal-retirement-compacts",
            title: "Coal Retirement Compacts",
            summary: "Negotiated early retirement of coal plants, with transition support for their workers and regions.",
            finance_cost: 300,
            mandate_cost: 4,
            duration_ticks: 100,
            repeat: Repeatable,
            cost_curve: Linear(increment_permille: 80),
            activation: Completion,
            prerequisites: [
                CompletedOnLead(project: "grid-modernisation"),
            ],
            effects: [
                (op: ReduceSectorEmissions(sector: Power, milli_gt: 800), scope: LeadContinent),
            ],
            context: (
                what: "Compensated closure agreements for existing coal capacity, paired with worker transition programmes.",
                why: "Existing plants keep emitting for decades unless retired ahead of their economic life.",
                depends_on: "Replacement generation on the grid and credible support for affected communities.",
                limits: "Politically contentious; unjust closures create durable opposition.",
                in_this_scenario: "A cheap, fast Power reduction that spends Mandate rather than Finance, gated on grid readiness.",
                abstraction: "Just-transition programmes are folded into the Mandate cost rather than modelled separately.",
                sources: ["IPCC AR6 WGIII ch.6", "ILO just-transition guidelines"],
            ),
        ),
        (
            id: "continental-interconnection",
            title: "Continental Interconnection",
            summary: "Long-distance transmission links that share clean power across regions.",
            finance_cost: 800,
            mandate_cost: 0,
            duration_ticks: 250,
            repeat: CappedRollout(per_continent: 1),
            cost_curve: Flat,
            activation: Completion,
            prerequisites: [
                IconAtLeast(icon: Infrastructure, amount: 3),
            ],
            effects: [
                (op: ReduceSectorEmissions(sector: Power, milli_gt: 200), scope: AllContinents),
                (op: AddIcon(icon: Infrastructure, amount: 1), scope: LeadContinent),
            ],
            context: (
                what: "HVDC corridors and interties that move surplus clean generation between balancing areas.",
                why: "Interconnection smooths variable supply and lets the cheapest clean power displace the dirtiest.",
                depends_on: "Mature grid institutions on the lead continent and cross-border agreement.",
                limits: "Small direct effect; the value is shared and systemic.",
                in_this_scenario: "A shared effect: a modest Power reduction on every continent at once.",
                abstraction: "One link per lead continent stands in for a portfolio of interties.",
                sources: ["IPCC AR6 WGIII ch.6", "IEA Net Zero Roadmap (2023 update)"],
            ),
        ),
        // ------------------------------------------- transport & buildings
        (
            id: "transit-and-rail",
            title: "Transit & Rail Expansion",
            summary: "Public transport, intercity rail, and the compact development they anchor.",
            finance_cost: 450,
            mandate_cost: 0,
            duration_ticks: 150,
            repeat: Repeatable,
            cost_curve: Linear(increment_permille: 60),
            activation: Completion,
            effects: [
                (op: ReduceSectorEmissions(sector: TransportAndBuildings, milli_gt: 500), scope: LeadContinent),
                (op: AddIcon(icon: Infrastructure, amount: 1), scope: LeadContinent),
            ],
            context: (
                what: "Urban transit, intercity rail, active-travel networks, and transit-oriented development.",
                why: "Avoided and shifted travel demand cuts emissions that vehicle electrification alone cannot reach quickly.",
                depends_on: "Land-use planning, construction capacity, and sustained operating support.",
                limits: "Slow to reshape existing sprawl; benefits compound over decades.",
                in_this_scenario: "A steady Transport & Buildings reduction that also builds Infrastructure.",
                abstraction: "The sector deliberately is not reduced to private EVs and appliance swaps.",
                sources: ["IPCC AR6 WGIII ch.8 and ch.10", "IEA Net Zero Roadmap (2023 update)"],
            ),
        ),
        (
            id: "building-retrofit-programme",
            title: "Building Retrofit Programme",
            summary: "Mass insulation and heat-pump retrofits across the existing building stock.",
            finance_cost: 400,
            mandate_cost: 0,
            duration_ticks: 160,
            repeat: Repeatable,
            cost_curve: Linear(increment_permille: 60),
            activation: LinearRollout,
            scaling: [
                (icon: Workforce, permille_per_icon: 60, cap_permille: 500),
            ],
            effects: [
                (op: ReduceSectorEmissions(sector: TransportAndBuildings, milli_gt: 400), scope: LeadContinent),
                (op: AddIcon(icon: Workforce, amount: 1), scope: LeadContinent),
            ],
            context: (
                what: "Envelope retrofits, efficient heating, and standards for the building stock that already exists.",
                why: "Most buildings standing in 1990 are still standing decades later; their emissions are locked in unless retrofitted.",
                depends_on: "A trained retrofit workforce above all — the binding constraint in every real programme.",
                limits: "Labour-limited street-by-street work; benefits arrive gradually, not at a ribbon-cutting.",
                in_this_scenario: "A linear-rollout reduction whose effect arrives during construction and scales with Workforce.",
                abstraction: "Heating fuel and building electricity are folded into one sector rate.",
                sources: ["IPCC AR6 WGIII ch.9", "IEA Net Zero Roadmap (2023 update)"],
            ),
        ),
        (
            id: "electrification-programme",
            title: "Transport & Heat Electrification",
            summary: "Electrify vehicles and heating at scale on the back of a modernised grid.",
            finance_cost: 550,
            mandate_cost: 1,
            duration_ticks: 150,
            repeat: Repeatable,
            cost_curve: Linear(increment_permille: 50),
            activation: Completion,
            prerequisites: [
                CompletedOnLead(project: "grid-modernisation"),
                IconAtLeast(icon: Infrastructure, amount: 3),
            ],
            effects: [
                (op: ReduceSectorEmissions(sector: TransportAndBuildings, milli_gt: 600), scope: LeadContinent),
            ],
            context: (
                what: "Vehicle electrification, charging networks, and electric heat displacing oil and gas end uses.",
                why: "Electrified end uses inherit the grid's falling carbon intensity.",
                depends_on: "A modernised grid and enough clean generation to make electrification a real reduction.",
                limits: "Electrifying onto a dirty grid moves emissions rather than cutting them — hence the prerequisites.",
                in_this_scenario: "A strong Transport & Buildings reduction, gated on grid readiness.",
                abstraction: "Charging, vehicles, and heat appliances are one programme.",
                sources: ["IPCC AR6 WGIII ch.8", "IEA Net Zero Roadmap (2023 update)"],
            ),
        ),
        // ---------------------------------------------- industry & land
        (
            id: "industrial-efficiency-standards",
            title: "Industrial Efficiency Standards",
            summary: "Global efficiency and material-use standards for heavy industry.",
            finance_cost: 500,
            mandate_cost: 3,
            duration_ticks: 120,
            repeat: Unique,
            cost_curve: Flat,
            activation: Completion,
            effects: [
                (op: ReduceSectorEmissions(sector: IndustryAndLand, milli_gt: 300), scope: AllContinents),
                (op: AddIcon(icon: Knowledge, amount: 1), scope: AllContinents),
                (op: AddIcon(icon: Institutions, amount: 1), scope: AllContinents),
                (op: UnlockProject(project: "industrial-deep-decarbonisation"), scope: Global),
            ],
            context: (
                what: "Efficiency standards, material-efficiency codes, and measurement regimes for steel, cement, and chemicals.",
                why: "Standards move whole industries at once and build the institutional base for deeper cuts.",
                depends_on: "Treaty coordination — this is what Mandate is for.",
                limits: "Efficiency alone cannot zero industrial emissions; it opens the path to process change.",
                in_this_scenario: "A one-time global reduction that seeds Knowledge and Institutions everywhere and unlocks deep decarbonisation.",
                abstraction: "Industry and land use are grouped into one sector for prototype simplicity.",
                sources: ["IPCC AR6 WGIII ch.11", "IEA industry roadmaps"],
            ),
        ),
        (
            id: "industrial-deep-decarbonisation",
            title: "Industrial Deep Decarbonisation",
            summary: "Process-level transformation: clean steel, cement, industrial heat, and fertiliser.",
            finance_cost: 700,
            mandate_cost: 1,
            duration_ticks: 200,
            repeat: Repeatable,
            cost_curve: Exponential(growth_permille: 60),
            activation: Completion,
            locked: true,
            prerequisites: [
                IconAtLeast(icon: Knowledge, amount: 3),
            ],
            breakpoints: [
                (id: "demonstration-effect", icon: Knowledge, at_least: 5, bonus_permille: 150),
            ],
            effects: [
                (op: ReduceSectorEmissions(sector: IndustryAndLand, milli_gt: 700), scope: LeadContinent),
            ],
            context: (
                what: "Hydrogen direct-reduction steel, clinker substitution, electrified industrial heat, and fertiliser process change.",
                why: "Beyond efficiency, industrial emissions fall only through changed processes.",
                depends_on: "Accumulated Knowledge — demonstration plants, standards, and institutional learning.",
                limits: "Each successive tranche is harder: the curve rises, not falls.",
                in_this_scenario: "The deep Industry & Land reduction, unlocked by standards and gated on Knowledge.",
                abstraction: "Dozens of distinct process routes are one repeatable programme.",
                sources: ["IPCC AR6 WGIII ch.11", "peer-reviewed industrial-decarbonisation reviews"],
            ),
        ),
        (
            id: "methane-and-land-programme",
            title: "Methane & Land Programme",
            summary: "Methane capture, fertiliser management, and ecosystem protection.",
            finance_cost: 250,
            mandate_cost: 0,
            duration_ticks: 80,
            repeat: CappedRollout(per_continent: 2),
            cost_curve: Flat,
            activation: Completion,
            effects: [
                (op: ReduceSectorEmissions(sector: IndustryAndLand, milli_gt: 500), scope: LeadContinent),
            ],
            context: (
                what: "Fugitive-methane capture, fertiliser efficiency, and protecting standing ecosystems from conversion.",
                why: "Methane cuts act fast, and avoided land conversion is among the cheapest large reductions available.",
                depends_on: "Monitoring capability and land governance.",
                limits: "The cheap opportunities are finite — hence the per-continent cap.",
                in_this_scenario: "A fast, cheap, capped Industry & Land reduction.",
                abstraction: "Protection is modelled as a reduction from the fixed baseline, not as dynamic land-use change.",
                sources: ["IPCC AR6 WGIII ch.7", "UNEP Emissions Gap Report"],
            ),
        ),
        // ---------------------------------------------------- coordination
        (
            id: "cfa-regional-secretariats",
            title: "CFA Regional Secretariats",
            summary: "Staffed regional institutions that expand the CFA's coordination capacity.",
            finance_cost: 400,
            mandate_cost: 2,
            duration_ticks: 120,
            repeat: Tiered(count: 3),
            cost_curve: Linear(increment_permille: 300),
            activation: Completion,
            effects: [
                (op: AddIcon(icon: Institutions, amount: 2), scope: LeadContinent),
                (op: AddMandateMaximum(milli: 3000), scope: Global),
                (op: AddMandateIncome(milli_per_tick: 1000), scope: Global),
            ],
            context: (
                what: "Regional offices, delegated authority, and the administrative machinery of coordination.",
                why: "Coordination capacity — not raw finance — gates how many programmes can run at once.",
                depends_on: "Member-state agreement to host and staff each secretariat.",
                limits: "The CFA coordinates and finances; it cannot bypass democratic authority.",
                in_this_scenario: "Builds Institutions toward the programme-slot milestones and raises Mandate capacity.",
                abstraction: "Mandate is global treaty coordination authority, not local public consent.",
                sources: ["IPCC AR6 WGIII ch.13-14 (international cooperation)"],
            ),
        ),
    ],
)
